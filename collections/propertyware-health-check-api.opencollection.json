{
  "opencollection": "1.0.0",
  "info": {
    "name": "Open API, powered by Propertyware Accounting Health check API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-propertyware-client-id",
      "value": "{{x-propertyware-client-id}}",
