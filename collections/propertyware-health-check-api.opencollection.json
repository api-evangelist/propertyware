        {
          "info": {
            "name": "Health check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.propertyware.com/pw/api/rest/v1/health"
          },
          "docs": "Indicates whether the API is up and running correctly.<br/><br/>"
        }
      ]
    }
  ],
  "bundled": true
}